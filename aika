### 3. JavaScriptコード (`script.js`)
現在の日付を取得し、カレンダーの1日が何曜日から始まるかを計算して、自動で日付を生成するプログラムです。

```javascript
const yearMonthTitle = document.querySelector("#yearMonthTitle");
const calendarDays = document.querySelector("#calendarDays");
const prevBtn = document.querySelector("#prevBtn");
const nextBtn = document.querySelector("#nextBtn");

// 現在の「年」と「月」を取得して保持する
let today = new Date();
let currentYear = today.getFullYear();
let currentMonth = today.getMonth(); // 0が1月、11が12月

// カレンダーを表示するメインの関数
function createCalendar(year, month) {
    // タイトルを更新（例：2023年 10月）
    yearMonthTitle.textContent = `${year}年 ${month + 1}月`;

    // 表示する月の情報を取得
    const firstDay = new Date(year, month, 1).getDay(); // 1日の曜日 (0:日〜6:土)
    const lastDate = new Date(year, month + 1, 0).getDate(); // 今月の末日 (例: 30や31)

    // 一旦カレンダーの中身を空にする
    calendarDays.innerHTML = "";

    // 1. 1日の曜日より前の空白マスを作る
    for (let i = 0; i < firstDay; i++) {
        const emptyDiv = document.createElement("div");
        emptyDiv.classList.add("empty");
        calendarDays.appendChild(emptyDiv);
    }

    // 2. 日付のマスを作る（1日〜末日まで）
    for (let date = 1; date <= lastDate; date++) {
        const dayDiv = document.createElement("div");
        dayDiv.classList.add("day");
        dayDiv.textContent = date;

        // もし「今年」「今月」「今日」なら、目立つクラス(today)をつける
        if (year === today.getFullYear() && month === today.getMonth() && date === today.getDate()) {
            dayDiv.classList.add("today");
        }

        calendarDays.appendChild(dayDiv);
    }
}

// 前の月へ移動する関数
function prevMonth() {
    currentMonth--;
    if (currentMonth < 0) {
        currentMonth = 11;
        currentYear--;
    }
    createCalendar(currentYear, currentMonth);
}

// 次の月へ移動する関数
function nextMonth() {
    currentMonth++;
    if (currentMonth > 11) {
        currentMonth = 0;
        currentYear++;
    }
    createCalendar(currentYear, currentMonth);
}

// ボタンにクリックイベントを設定
prevBtn.addEventListener("click", prevMonth);
nextBtn.addEventListener("click", nextMonth);

// 最初にページを開いたときにカレンダーを表示する
createCalendar(currentYear, currentMonth);
```
